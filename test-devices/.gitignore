# Device private keys are auto-generated by tcp_tunnel_device on startup
# (see `keys/device.key` in `tcp_tunnel_device --help`). The Swift tests never
# pin a local device fingerprint (fp is nil for all `local: true` devices), so
# an ephemeral per-run key is fine and must not be committed.
config/*/keys/

# NOTE: config/*/state/ is intentionally NOT ignored. tcp_tunnel_device does
# not auto-create the IAM state file (unlike the device key) and refuses to
# start without it, so the baseline state must be committed. run-all.sh resets
# it to the committed baseline before each run.
