# Device private keys are auto-generated by tcp_tunnel_device on startup
# (see `keys/device.key` in `tcp_tunnel_device --help`). The Swift tests never
# pin a local device fingerprint (fp is nil for all `local: true` devices), so
# an ephemeral per-run key is fine and must not be committed.
config/*/keys/

# Mutating runtime pairing state; regenerated on each run.
config/*/state/
